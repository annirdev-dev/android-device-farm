{
  "name": "android-device-farm",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted Android device farm: real, isolated Android Emulator instances streamed to the browser.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @devicefarm/database run generate",
    "db:migrate": "pnpm --filter @devicefarm/database run migrate",
    "db:seed": "pnpm --filter @devicefarm/database run seed",
    "db:studio": "pnpm --filter @devicefarm/database run studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
