# Copy this file to .env at the repo root and fill in real values before
# running any service locally (pnpm dev) or with docker-compose.
# See docs/SETUP.md for a walkthrough and docs/EMULATOR_HOST_SETUP.md for the
# Linux/KVM prerequisites needed before EMULATOR_PROVIDER=real will work.

NODE_ENV=development

# --- Core infra -------------------------------------------------------------
DATABASE_URL=postgresql://devicefarm:devicefarm@localhost:5432/devicefarm
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=7d
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Service addresses ---------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
STREAMING_GATEWAY_PORT=4100
STREAMING_GATEWAY_PUBLIC_URL=ws://localhost:4100
EMULATOR_WORKER_PORT=4200

# --- Object storage (MinIO locally, any S3-compatible bucket in prod) --------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devicefarm
S3_SECRET_ACCESS_KEY=devicefarm-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_APPS=devicefarm-apps
S3_BUCKET_SCREENSHOTS=devicefarm-screenshots
S3_BUCKET_RECORDINGS=devicefarm-recordings

# --- Emulator / compute -------------------------------------------------------
# "mock" runs MockEmulatorProvider (no KVM needed) - safe default everywhere
# except a real, provisioned Linux+KVM host. NEVER set this to "real" unless
# you are actually on such a host with the Android SDK installed - the worker
# refuses to boot with EMULATOR_PROVIDER=mock in NODE_ENV=production.
EMULATOR_PROVIDER=mock
COMPUTE_PROVIDER=local
ANDROID_SDK_ROOT=/opt/android-sdk
EMULATOR_DATA_ROOT=/var/lib/devicefarm/emulators

# --- Session lifecycle ---------------------------------------------------------
SESSION_ABANDONED_TIMEOUT_MINUTES=10
SESSION_MAX_DURATION_MINUTES=60

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Optional integrations ------------------------------------------------------
CLAMAV_HOST=
CLAMAV_PORT=3310
STRIPE_SECRET_KEY=
